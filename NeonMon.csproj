<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>NeonMon.ico</ApplicationIcon>
    <AssemblyName>NeonMon</AssemblyName>
    <RootNamespace>NeonMon</RootNamespace>
    <DebugType>embedded</DebugType>
    <SelfContained>false</SelfContained>
    <!-- WinForms resolves the keyboard layout's culture on WM_INPUTLANGCHANGE; invariant mode throws there. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Include="tools\neonmon-statusline.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.20" />
  </ItemGroup>
</Project>
